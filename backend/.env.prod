# ═══════════════════════════════════════════
# Warhammer Portal — PRODUCTION Environment
# ═══════════════════════════════════════════
# ⚠️  CHANGE ALL VALUES BEFORE DEPLOYING TO PRODUCTION
SECRET_KEY=CHANGE-ME-generate-with-python-c-from-django.core.management.utils-import-get_random_secret_key
ENVIRONMENT=prod
DEBUG=False
ALLOWED_HOSTS=warhammer-portal.com,www.warhammer-portal.com
CORS_ALLOWED_ORIGINS=https://warhammer-portal.com,https://www.warhammer-portal.com

# Database — Production uses its OWN database
DB_NAME=warhammer_portal_prod
DB_USER=wh_prod_user
DB_PASSWORD=CHANGE-ME-use-a-strong-generated-password
DB_HOST=localhost
DB_PORT=5432

# Security
SECURE_SSL_REDIRECT=True

